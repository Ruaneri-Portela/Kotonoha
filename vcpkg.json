{
  "name": "kotonoha",
  "version-string": "0.1.0",
  "builtin-baseline": "9a5dfef5d1a0438a7d24856a85bd60f309d355e9",
  "overrides": [
    {
      "name": "vcpkg-tool-meson",
      "version": "1.9.0",
      "port-version": 10
    }
  ],
  "dependencies": [
    "freetype",
    "harfbuzz",
    "json-c",
    "libass",
    {
      "name": "ffmpeg",
      "features": [
        "zlib"
      ]
    },
    {
      "name": "libiconv",
      "platform": "!osx & !ios"
    },
    {
      "name": "python3",
      "platform": "windows & !mingw"
    },
    {
      "name": "fontconfig",
      "platform": "android | ios | osx | mingw"
    },
    {
      "name": "libunibreak",
      "platform": "android | ios | osx | mingw"
    },
    {
      "name": "plutosvg",
      "features": [
        "freetype"
      ]
    },
    "zlib",
    {
      "name": "pkgconf",
      "host": true
    }
  ],
  "features": {
    "imgui-vcpkg": {
      "description": "Use Dear ImGui (with SDL3 backends) from vcpkg instead of the pinned submodule",
      "dependencies": [
        {
          "name": "imgui",
          "features": [
            "sdl3-binding",
            "sdl3-renderer-binding"
          ]
        }
      ]
    },
    "android-python": {
      "description": "CPython runtime for the Android DDLC flavor",
      "dependencies": [
        {
          "name": "python3",
          "platform": "android"
        }
      ]
    },
    "sdl-vcpkg": {
      "description": "Use SDL3 and SDL3_ttf from vcpkg in lieu of submodules",
      "dependencies": [
        {
          "name": "sdl3",
          "features": [
            "x11"
          ],
          "platform": "linux",
          "default-features": false
        },
        {
          "name": "sdl3",
          "platform": "!linux",
          "default-features": false
        },
        {
          "name": "sdl3-ttf",
          "features": [
            "harfbuzz",
            "svg"
          ],
          "default-features": false
        }
      ]
    }
  }
}
