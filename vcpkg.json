{
  "name": "kotonoha",
  "version-string": "0.1.0",
  "builtin-baseline": "ada4709cf238a75753b71b99681e1c5d31a078c9",
  "dependencies": [
    "freetype",
    "harfbuzz",
    "json-c",
    "libass",
    {
      "name": "fontconfig",
      "platform": "android | ios"
    },
    {
      "name": "libunibreak",
      "platform": "android | ios"
    },
    {
      "name": "libiconv",
      "platform": "android"
    },
    {
      "name": "plutosvg",
      "features": ["freetype"]
    },
    "zlib",
    {
      "name": "ffmpeg",
      "features": ["zlib"]
    },
    {
      "name": "pkgconf",
      "host": true
    }
  ],
  "features": {
    "android-python": {
      "description": "Embedded CPython runtime for the Android DDLC app",
      "dependencies": [
        {
          "name": "python3",
          "platform": "android"
        }
      ]
    }
  }
}
