foreach(required RESOURCE_SOURCE RESOURCE_DESTINATION GAME_SOURCE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "Missing asset packaging argument: ${required}")
    endif()
endforeach()
if(NOT IS_DIRECTORY "${RESOURCE_SOURCE}")
    message(FATAL_ERROR "Engine asset source directory is missing: ${RESOURCE_SOURCE}")
endif()
if(INCLUDE_GAME_ASSETS AND NOT IS_DIRECTORY "${GAME_SOURCE}")
    message(FATAL_ERROR "Game asset source directory is missing: ${GAME_SOURCE}")
endif()
file(MAKE_DIRECTORY "${RESOURCE_DESTINATION}/assets")
file(COPY "${RESOURCE_SOURCE}/" DESTINATION "${RESOURCE_DESTINATION}/assets")
set(GAME_ASSET_DIR "${RESOURCE_DESTINATION}/game-assets")
if(INCLUDE_GAME_ASSETS)
    file(MAKE_DIRECTORY "${GAME_ASSET_DIR}")
    file(COPY "${GAME_SOURCE}/" DESTINATION "${GAME_ASSET_DIR}")
else()
    include("${CMAKE_CURRENT_LIST_DIR}/CheckBundledAssets.cmake")
    file(MAKE_DIRECTORY "${GAME_ASSET_DIR}")
endif()
