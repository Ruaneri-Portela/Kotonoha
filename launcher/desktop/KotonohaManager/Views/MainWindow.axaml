<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Kotonoha.Manager.ViewModels"
        x:Class="Kotonoha.Manager.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1180" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Icon="avares://KotonohaManager/Assets/icon.ico"
        Title="{Binding Strings.AppTitle}">

    <Grid>
    <DockPanel>
        <!-- Cabecalho: identidade, busca e acoes (padrao Android/iOS). -->
        <Border Classes="Header" DockPanel.Dock="Top">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" VerticalAlignment="Center">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                    <Border Width="36" Height="36" CornerRadius="8" Background="#0F6CBD">
                        <TextBlock Text="✿" FontSize="22" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel>
                        <TextBlock Text="Kotonoha" Classes="Accent" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Universal Visual Novel Hub" Classes="Muted" FontSize="11" />
                    </StackPanel>
                </StackPanel>

                <TextBox Grid.Column="1" Width="270" Margin="24,0,12,0"
                         PlaceholderText="{Binding Strings.SearchPlaceholder}"
                         Text="{Binding SearchQuery}" />

                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                    <ComboBox Width="110" ItemsSource="{Binding Languages}"
                              SelectedItem="{Binding SelectedLanguage}" />
                    <Button Classes="Ghost" Content="{Binding Strings.Rescan}" Command="{Binding ScanCommand}" />
                    <Button Classes="Ghost" Content="{Binding Strings.AddFolder}" Click="AddFolder_Click" />
                    <Button Classes="Ghost" Content="{Binding Strings.AddDisc}" Click="AddDisc_Click" />
                    <Button Classes="Ghost" Content="{Binding Strings.AddZip}" Click="ImportZip_Click" />
                    <Button Classes="Ghost" Content="{Binding Strings.Settings}" Click="Settings_Click" />
                    <Button Classes="Primary" Content="{Binding Strings.Quit}" Click="Quit_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="330,4,*">
            <!-- Biblioteca -->
            <Grid Grid.Column="0" RowDefinitions="Auto,*">
                <TextBlock Grid.Row="0" Text="{Binding Strings.Library}" Classes="Accent"
                           Margin="16,14,0,10" FontSize="14" FontWeight="SemiBold" />
                <ListBox Grid.Row="1" ItemsSource="{Binding VisibleGames}"
                         SelectedItem="{Binding SelectedGame}"
                         Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:GameEntryViewModel">
                            <Border Classes="GameCard">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                    <TextBlock Grid.Row="0" Text="{Binding Title}"
                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding Engine}" FontSize="11" />
                                        </Border>
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding KindBadge}" FontSize="11" />
                                        </Border>
                                        <Border Classes="Badge" IsVisible="{Binding HasOverlay}">
                                            <TextBlock Text="OVERLAY" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Row="2" Text="{Binding PathText}" Classes="Muted"
                                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,8,0,0" />
                                    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Grid.Column="0" Text="{Binding StatusText}"
                                                   Foreground="#7FC8A8" FontSize="11" />
                                        <Button Grid.Column="1" Classes="Primary"
                                                Content="{Binding ActionLabel}"
                                                Padding="10,2" FontSize="12"
                                                Click="PlayCard_Click" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>

            <GridSplitter Grid.Column="1" Width="4" Background="#3D4763" />

            <!-- Detalhes do jogo selecionado -->
            <ScrollViewer Grid.Column="2" Padding="24">
                <StackPanel Spacing="14">
                    <!-- ContentControl evita avaliar bindings de SelectedGame quando
                         nenhum jogo esta selecionado (evita avisos "Value is null"). -->
                    <ContentControl Content="{Binding SelectedGame}"
                                    IsVisible="{Binding HasSelection}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate DataType="vm:GameEntryViewModel">
                                <StackPanel Spacing="14">
                                    <TextBlock Text="{Binding Title}" Classes="Accent"
                                               FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding Engine}" />
                                        </Border>
                                        <Border Classes="Badge">
                                            <TextBlock Text="{Binding KindBadge}" />
                                        </Border>
                                        <Border Classes="Badge" IsVisible="{Binding HasOverrides}">
                                            <TextBlock Text="PARÂMETROS CUSTOM" />
                                        </Border>
                                    </StackPanel>

                                    <Border Classes="Surface" Padding="16">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{Binding PathLabel}" Classes="Muted" />
                                            <TextBlock Text="{Binding PathText}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SaveDirectoryLabel}" Classes="Muted"
                                                       Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding SaveDirectory}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Classes="Primary" Content="{Binding ActionLabel}"
                                                FontSize="15" Click="PlayCard_Click" />
                                        <Button Classes="Ghost" Content="{Binding ParametersLabel}"
                                                Click="Parameters_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>

                    <Border Classes="Surface" Padding="12">
                        <StackPanel Spacing="6">
                            <TextBlock Text="{Binding Strings.ExecutionLog}" Classes="Accent"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding GameLog}" Classes="Muted" TextWrapping="Wrap"
                                       MaxHeight="260" FontFamily="Consolas, Monospace" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>

    <!-- Notificacao WinUI 3: aparece alguns segundos depois do scan. -->
    <Border Classes="Surface" HorizontalAlignment="Right" VerticalAlignment="Top"
            Margin="0,104,16,0" Padding="16,10" CornerRadius="8"
            IsVisible="{Binding NotificationVisible}">
        <TextBlock Text="{Binding NotificationText}" Foreground="#FFFFFF" />
    </Border>
    </Grid>
</Window>
