<resources>
    <style name="SdText" parent="@android:style/Widget.TextView">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">#173752</item>
        <item name="android:textSize">17sp</item>
    </style>
    <style name="SdHeading" parent="SdText">
        <item name="android:textSize">22sp</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="SdButton" parent="@android:style/Widget.Material.Light.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textColor">#123454</item>
        <item name="android:backgroundTint">#DCEBF2</item>
    </style>
</resources>
