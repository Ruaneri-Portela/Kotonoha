<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Kotonoha.Launcher" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Hierarquia oficial Navy -> Raised -> Violet/Magenta, com a
             variante Soft para superficies e acentos menos gritantes. -->
        <item name="colorPrimary">@color/kotonoha_violet</item>
        <item name="colorOnPrimary">@color/kotonoha_white</item>
        <item name="colorSecondary">@color/kotonoha_soft_accent</item>
        <item name="colorOnSecondary">@color/kotonoha_navy</item>
        <item name="colorTertiary">@color/kotonoha_soft_accent_dim</item>
        <item name="colorOnTertiary">@color/kotonoha_navy</item>
        <item name="colorError">@color/kotonoha_error_soft</item>
        <item name="colorOnError">@color/kotonoha_navy</item>
        <item name="colorControlHighlight">@color/kotonoha_soft_accent_dim</item>
        <item name="colorSurface">@color/kotonoha_soft_surface</item>
        <item name="colorOnSurface">@color/kotonoha_text</item>
        <item name="colorSurfaceVariant">@color/kotonoha_soft_surface_raised</item>
        <item name="colorOnSurfaceVariant">@color/kotonoha_text_muted</item>
        <item name="colorOutline">@color/kotonoha_soft_outline</item>
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Kotonoha.SmallComponent</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Kotonoha.MediumComponent</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Kotonoha.LargeComponent</item>
        <item name="android:windowBackground">@color/kotonoha_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
    <style name="Theme.Kotonoha.Splash" parent="Theme.Kotonoha.Launcher">
        <item name="android:windowBackground">@color/kotonoha_black</item>
    </style>
</resources>
