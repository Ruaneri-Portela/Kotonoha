// RealLive-only configuration for macOS. Do not affect other game targets.
#include "Game.macOS.xcconfig"

// Vendor headers use both <libreallive/...> and local quoted include forms.
HEADER_SEARCH_PATHS = $(inherited) \
    "$(KOTONOHA_ROOT)/games/reallive/vendor" \
    "$(KOTONOHA_ROOT)/games/reallive/vendor/machine" \
    "$(KOTONOHA_ROOT)/games/reallive/vendor/libreallive"
