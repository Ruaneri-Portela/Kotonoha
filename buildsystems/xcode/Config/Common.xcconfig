// Shared by macOS, iOS, simulator, games and frameworks.
// Project directory: <repository>/buildsystems/xcode/
KOTONOHA_ROOT = $(SRCROOT)/../..

// Architectures: macOS is universal (Apple Silicon + Intel). iOS and the iOS
// Simulator are arm64-only because the vcpkg iOS triplets are arm64-only.
// Debug keeps the active arch; Release is universal.
ARCHS = arm64 x86_64
ARCHS[sdk=iphoneos*] = arm64
ARCHS[sdk=iphonesimulator*] = arm64
ONLY_ACTIVE_ARCH = YES
ONLY_ACTIVE_ARCH[config=Release] = NO

// Minimum deployment targets: macOS 15.0 and iOS 15.0.
MACOSX_DEPLOYMENT_TARGET = 15.0
IPHONEOS_DEPLOYMENT_TARGET = 15.0

// macOS desktop builds consume the dynamic vcpkg triplets produced by
// `cmake --preset macos-arm64-vcpkg` / `cmake --preset macos-amd64-vcpkg`, so
// Xcode and CMake use the same dependency artifacts. iOS keeps its own
// triplets. SDL3 and SDL3_ttf come from the Xcode projects in lib/submodules
// (dynamic frameworks); the remaining dependencies come from vcpkg. The
// install root and triplet below must stay in sync with CMakePresets.json:
// out/build/macos-arm64-vcpkg/vcpkg_installed (arm64) and
// out/build/macos-amd64-vcpkg/vcpkg_installed (x86_64 architecture). The
// amd64 spelling is only a name; the compiler and vcpkg still target x86_64.
KOTONOHA_VCPKG_PARENT = $(KOTONOHA_ROOT)/out/build/macos-arm64-vcpkg/vcpkg_installed
KOTONOHA_VCPKG_PARENT[arch=x86_64] = $(KOTONOHA_ROOT)/out/build/macos-amd64-vcpkg/vcpkg_installed
KOTONOHA_VCPKG_PARENT[sdk=iphoneos*] = $(KOTONOHA_ROOT)/buildsystems/xcode/vcpkg/ios
KOTONOHA_VCPKG_PARENT[sdk=iphonesimulator*] = $(KOTONOHA_ROOT)/buildsystems/xcode/vcpkg/simulator
KOTONOHA_VCPKG_TRIPLET = macos-arm64-vcpkg
KOTONOHA_VCPKG_TRIPLET[arch=x86_64] = macos-amd64-vcpkg
KOTONOHA_VCPKG_TRIPLET[sdk=iphoneos*] = arm64-ios
KOTONOHA_VCPKG_TRIPLET[sdk=iphonesimulator*] = arm64-ios-simulator
KOTONOHA_VCPKG_INCLUDE = $(KOTONOHA_VCPKG_PARENT)/$(KOTONOHA_VCPKG_TRIPLET)/include
KOTONOHA_VCPKG_LIB = $(KOTONOHA_VCPKG_PARENT)/$(KOTONOHA_VCPKG_TRIPLET)/lib


// All Xcode application targets (including the native Unified Launcher) use
