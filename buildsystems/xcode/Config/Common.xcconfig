// Shared by macOS, iOS, simulator, games and frameworks.
// Project directory: <repository>/buildsystems/xcode/
KOTONOHA_ROOT = $(SRCROOT)/../..

// Set the correct triplet and root for every destination. Override these values
// locally if your vcpkg output uses a different directory layout.
KOTONOHA_VCPKG_PARENT = $(KOTONOHA_ROOT)/buildsystems/xcode/vcpkg/macos
KOTONOHA_VCPKG_PARENT[sdk=iphoneos*] = $(KOTONOHA_ROOT)/buildsystems/xcode/vcpkg/ios
KOTONOHA_VCPKG_PARENT[sdk=iphonesimulator*] = $(KOTONOHA_ROOT)/buildsystems/xcode/vcpkg/simulator
KOTONOHA_VCPKG_TRIPLET = arm64-osx
KOTONOHA_VCPKG_TRIPLET[sdk=iphoneos*] = arm64-ios
KOTONOHA_VCPKG_TRIPLET[sdk=iphonesimulator*] = arm64-ios-simulator
KOTONOHA_VCPKG_INCLUDE = $(KOTONOHA_VCPKG_PARENT)/$(KOTONOHA_VCPKG_TRIPLET)/include
KOTONOHA_VCPKG_LIB = $(KOTONOHA_VCPKG_PARENT)/$(KOTONOHA_VCPKG_TRIPLET)/lib


// All Xcode application targets (including the native Unified Launcher) use
// providers and VMs compiled from their original modules, not copied sources.
// Keep these header roots shared so a multi-engine target can compile exactly
// the same source files as the standalone game targets.
KOTONOHA_MODULE_HEADER_ROOTS = \
    "$(KOTONOHA_ROOT)/modules/providers/adv/include" \
    "$(KOTONOHA_ROOT)/modules/providers/adv/src" \
    "$(KOTONOHA_ROOT)/modules/providers/amagami/include" \
    "$(KOTONOHA_ROOT)/modules/providers/amagami/src" \
    "$(KOTONOHA_ROOT)/modules/providers/cmp/include" \
    "$(KOTONOHA_ROOT)/modules/providers/cmp/src" \
    "$(KOTONOHA_ROOT)/modules/providers/gpk/include" \
    "$(KOTONOHA_ROOT)/modules/providers/gpk/src" \
    "$(KOTONOHA_ROOT)/modules/providers/n2/include" \
    "$(KOTONOHA_ROOT)/modules/providers/n2/src" \
    "$(KOTONOHA_ROOT)/modules/providers/pak/include" \
    "$(KOTONOHA_ROOT)/modules/providers/pak/src" \
    "$(KOTONOHA_ROOT)/modules/providers/pmail/include" \
    "$(KOTONOHA_ROOT)/modules/providers/pmail/src" \
    "$(KOTONOHA_ROOT)/modules/providers/ponscripter/include" \
    "$(KOTONOHA_ROOT)/modules/providers/ponscripter/src" \
    "$(KOTONOHA_ROOT)/modules/providers/reallive/include" \
    "$(KOTONOHA_ROOT)/modules/providers/reallive/src" \
    "$(KOTONOHA_ROOT)/modules/providers/rpa/include" \
    "$(KOTONOHA_ROOT)/modules/providers/rpa/src" \
    "$(KOTONOHA_ROOT)/modules/providers/xp3/include" \
    "$(KOTONOHA_ROOT)/modules/providers/xp3/src" \
    "$(KOTONOHA_ROOT)/modules/providers/zero/include" \
    "$(KOTONOHA_ROOT)/modules/providers/zero/src" \
    "$(KOTONOHA_ROOT)/modules/providers/artemis/include" \
    "$(KOTONOHA_ROOT)/modules/providers/artemis/src" \
    "$(KOTONOHA_ROOT)/modules/vms/amagami/include" \
    "$(KOTONOHA_ROOT)/modules/vms/amagami/src" \
    "$(KOTONOHA_ROOT)/modules/vms/artemis/include" \
    "$(KOTONOHA_ROOT)/modules/vms/artemis/src" \
    "$(KOTONOHA_ROOT)/modules/vms/kag/include" \
    "$(KOTONOHA_ROOT)/modules/vms/kag/src" \
    "$(KOTONOHA_ROOT)/modules/vms/meo/include" \
    "$(KOTONOHA_ROOT)/modules/vms/meo/src" \
    "$(KOTONOHA_ROOT)/modules/vms/n2system/include" \
    "$(KOTONOHA_ROOT)/modules/vms/n2system/src" \
    "$(KOTONOHA_ROOT)/modules/vms/pmail/include" \
    "$(KOTONOHA_ROOT)/modules/vms/pmail/src" \
    "$(KOTONOHA_ROOT)/modules/vms/ponscripter/include" \
    "$(KOTONOHA_ROOT)/modules/vms/ponscripter/src" \
    "$(KOTONOHA_ROOT)/modules/vms/reallive/include" \
    "$(KOTONOHA_ROOT)/modules/vms/reallive/src" \
    "$(KOTONOHA_ROOT)/modules/vms/renpy/include" \
    "$(KOTONOHA_ROOT)/modules/vms/renpy/src" \
    "$(KOTONOHA_ROOT)/modules/vms/snow-radish/include" \
    "$(KOTONOHA_ROOT)/modules/vms/snow-radish/src" \
    "$(KOTONOHA_ROOT)/modules/vms/summer-radish/include" \
    "$(KOTONOHA_ROOT)/modules/vms/summer-radish/src" \
    "$(KOTONOHA_ROOT)/modules/vms/tjs2/include" \
    "$(KOTONOHA_ROOT)/modules/vms/tjs2/src"

KOTONOHA_GAME_HEADER_ROOTS = \
    "$(KOTONOHA_ROOT)/games/amagami/include" \
    "$(KOTONOHA_ROOT)/games/amagami/src" \
    "$(KOTONOHA_ROOT)/games/zero-no-tsukaima/include" \
    "$(KOTONOHA_ROOT)/games/zero-no-tsukaima/src" \
    "$(KOTONOHA_ROOT)/games/snow-radish-vacation/include" \
    "$(KOTONOHA_ROOT)/games/snow-radish-vacation/src" \
    "$(KOTONOHA_ROOT)/games/summer-radish-vacation/include" \
    "$(KOTONOHA_ROOT)/games/summer-radish-vacation/src" \
    "$(KOTONOHA_ROOT)/games/doki-doki-literature-club/include" \
    "$(KOTONOHA_ROOT)/games/doki-doki-literature-club/src" \
    "$(KOTONOHA_ROOT)/games/katawa-shoujo/include" \
    "$(KOTONOHA_ROOT)/games/katawa-shoujo/src" \
    "$(KOTONOHA_ROOT)/games/school-days/include" \
    "$(KOTONOHA_ROOT)/games/school-days/src" \
    "$(KOTONOHA_ROOT)/games/reallive/include" \
    "$(KOTONOHA_ROOT)/games/reallive/src" \
    "$(KOTONOHA_ROOT)/games/reallive/vendor" \
    "$(KOTONOHA_ROOT)/games/kirikiri/include" \
    "$(KOTONOHA_ROOT)/games/kirikiri/src" \
    "$(KOTONOHA_ROOT)/games/luca-system/include" \
    "$(KOTONOHA_ROOT)/games/luca-system/src" \
    "$(KOTONOHA_ROOT)/games/artemis/include" \
    "$(KOTONOHA_ROOT)/games/artemis/src" \
    "$(KOTONOHA_ROOT)/games/pmail/include" \
    "$(KOTONOHA_ROOT)/games/pmail/src" \
    "$(KOTONOHA_ROOT)/games/meo/include" \
    "$(KOTONOHA_ROOT)/games/meo/src" \
    "$(KOTONOHA_ROOT)/games/n2system/include" \
    "$(KOTONOHA_ROOT)/games/n2system/src" \
    "$(KOTONOHA_ROOT)/games/ponscripter/include" \
    "$(KOTONOHA_ROOT)/games/ponscripter/src" \
    "$(KOTONOHA_ROOT)/launcher/include" \
    "$(KOTONOHA_ROOT)/launcher/src"

HEADER_SEARCH_PATHS = $(inherited) $(KOTONOHA_MODULE_HEADER_ROOTS) $(KOTONOHA_GAME_HEADER_ROOTS) "$(DERIVED_FILE_DIR)" "$(KOTONOHA_ROOT)/lib/include" \
    "$(KOTONOHA_ROOT)/lib/submodules/SDL/include" \
    "$(KOTONOHA_ROOT)/lib/submodules/SDL_ttf/include" \
    "$(KOTONOHA_ROOT)/lib/submodules/imgui" \
    "$(KOTONOHA_ROOT)/lib/submodules/imgui/backends" \
    "$(KOTONOHA_ROOT)/lib/submodules/imgui/misc/cpp" \
    "$(KOTONOHA_ROOT)/modules/providers/cmp/include" \
    "$(KOTONOHA_ROOT)/modules/providers/amagami/include" \
    "$(KOTONOHA_ROOT)/modules/providers/rpa/include" \
    "$(KOTONOHA_ROOT)/modules/providers/pak/include" \
    "$(KOTONOHA_ROOT)/modules/providers/adv/include" \
    "$(KOTONOHA_ROOT)/modules/providers/zero/include" \
    "$(KOTONOHA_ROOT)/modules/providers/reallive/include" \
    "$(KOTONOHA_ROOT)/modules/providers/gpk/include" \
    "$(KOTONOHA_ROOT)/modules/providers/xp3/include" \
    "$(KOTONOHA_ROOT)/modules/providers/pmail/include" \
    "$(KOTONOHA_ROOT)/modules/vms/snow-radish/include" \
    "$(KOTONOHA_ROOT)/modules/vms/amagami/include" \
    "$(KOTONOHA_ROOT)/modules/vms/meo/include" \
    "$(KOTONOHA_ROOT)/modules/vms/renpy/include" \
    "$(KOTONOHA_ROOT)/modules/vms/kag/include" \
    "$(KOTONOHA_ROOT)/modules/vms/reallive/include" \
    "$(KOTONOHA_ROOT)/modules/vms/summer-radish/include" \
    "$(KOTONOHA_ROOT)/modules/vms/pmail/include" \
    "$(KOTONOHA_ROOT)/games/$(KOTONOHA_GAME_DIR)/include" \
    "$(KOTONOHA_ROOT)/games/$(KOTONOHA_GAME_DIR)/src"
LIBRARY_SEARCH_PATHS = $(inherited) "$(KOTONOHA_VCPKG_LIB)"
FRAMEWORK_SEARCH_PATHS = $(inherited) "$(BUILT_PRODUCTS_DIR)" "$(KOTONOHA_ROOT)/lib/submodules/SDL/Xcode/SDL/build/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)" "$(KOTONOHA_ROOT)/lib/submodules/SDL/Xcode/SDL/build/$(CONFIGURATION)" "$(KOTONOHA_ROOT)/lib/submodules/SDL_ttf/Xcode/build/$(CONFIGURATION)$(EFFECTIVE_PLATFORM_NAME)" "$(KOTONOHA_ROOT)/lib/submodules/SDL_ttf/Xcode/build/$(CONFIGURATION)"
CLANG_CXX_LANGUAGE_STANDARD = c++17
CLANG_CXX_LIBRARY = libc++
// Keep vcpkg headers as system search paths after the Apple SDK so vcpkg's
// uuid/uuid.h never shadows Darwin's <uuid/uuid.h> during Swift PCM builds.
OTHER_CFLAGS = $(inherited) -isystem "$(KOTONOHA_VCPKG_INCLUDE)"
OTHER_CPLUSPLUSFLAGS = $(inherited) -isystem "$(KOTONOHA_VCPKG_INCLUDE)"
// macOS: optional features ON. iOS device and simulator: MCP OFF.
// MetalFX is unavailable in the iOS Simulator SDK.
KOTONOHA_MCP_DEF = KOTONOHA_ENABLE_MCP=1
KOTONOHA_MCP_DEF[sdk=iphoneos*] = KOTONOHA_ENABLE_MCP=0
KOTONOHA_MCP_DEF[sdk=iphonesimulator*] = KOTONOHA_ENABLE_MCP=0
KOTONOHA_METALFX_DEF = KOTONOHA_HAS_METALFX=1
KOTONOHA_METALFX_DEF[sdk=iphonesimulator*] =
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) $(KOTONOHA_METALFX_DEF) KOTONOHA_ENABLE_UPSCALER=1 $(KOTONOHA_MCP_DEF)

// The original projects link dynamic SDL3 / SDL3_ttf and vcpkg libraries.
// CoreFoundation handles engine text conversion, but bundled/third-party
// libraries may still reference _iconv_open/_iconv/_iconv_close.
// Keep the Apple SDK's libiconv linked for all macOS/iOS app targets.
KOTONOHA_SHARED_LIBS = -ljson-c -lass -lz -lharfbuzz -lfribidi -lfreetype -lfontconfig -liconv -lbz2 -lbrotlidec -lbrotlicommon -lexpat -lpng -lunibreak
KOTONOHA_FFMPEG_LIBS = -lavcodec -lavformat -lavutil -lswresample -lswscale
