    "$(KOTONOHA_ROOT)/modules/formats/image/tim2/include" \
    "$(KOTONOHA_ROOT)/modules/formats/image/ui-atlas/include" \
    "$(KOTONOHA_ROOT)/modules/formats/image/tlg/include" \
    "$(KOTONOHA_ROOT)/modules/providers/adv/include" \
    "$(KOTONOHA_ROOT)/modules/providers/adv/src" \
    "$(KOTONOHA_ROOT)/modules/providers/amagami/include" \
