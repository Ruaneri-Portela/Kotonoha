#include "Common.xcconfig"
KOTONOHA_METALFX_LDFLAGS = -weak_framework MetalFX
KOTONOHA_METALFX_LDFLAGS[sdk=iphonesimulator*] =
KOTONOHA_APPLE_LIBS = -framework CoreFoundation -framework UIKit -framework Foundation -framework Metal -framework AudioToolbox -framework CoreMedia -framework CoreVideo -framework VideoToolbox -framework OpenGLES -framework CoreText $(KOTONOHA_METALFX_LDFLAGS)
// SDL3/SDL3_ttf static vcpkg builds need AVFoundation/GameController/etc.
// plutosvg provides the SVG hooks used by SDL3_ttf's harfbuzz/svg feature.
OTHER_LDFLAGS = $(inherited) $(KOTONOHA_SHARED_LIBS) $(KOTONOHA_FFMPEG_LIBS) $(KOTONOHA_APPLE_LIBS) \
    -lSDL3 -lSDL3_ttf -lplutosvg -lplutovg -limgui \
    -framework AVFoundation -framework CoreGraphics -framework QuartzCore \
    -framework GameController -framework CoreBluetooth -framework CoreHaptics \
    -framework CoreMotion -framework ImageIO
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
