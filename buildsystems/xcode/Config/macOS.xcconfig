#include "Common.xcconfig"
KOTONOHA_APPLE_LIBS = -framework CoreFoundation -framework Cocoa -framework OpenGL -framework AudioToolbox -framework CoreMedia -framework CoreVideo -framework VideoToolbox -framework Metal -weak_framework MetalFX
// macOS deliverables consume SDL3, SDL3_ttf and Dear ImGui exclusively from
// vcpkg (manifest features sdl-vcpkg + imgui-vcpkg). No submodule frameworks
// or submodule ImGui sources are used by the Xcode macOS targets.
OTHER_LDFLAGS = $(inherited) $(KOTONOHA_SHARED_LIBS) $(KOTONOHA_FFMPEG_LIBS) $(KOTONOHA_APPLE_LIBS) -lSDL3 -lSDL3_ttf -limgui
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks @loader_path/Frameworks
