// Native Xcode build of the unified in-process launcher; no CMake bridge.
// Ren'Py ports share the same CPython SDK and runtime.
#include "DokiDoki.macOS.xcconfig"

KOTONOHA_GAME_DIR = launcher
SWIFT_VERSION = 5.0
SWIFT_OBJC_BRIDGING_HEADER = $(KOTONOHA_ROOT)/launcher/app/macos/KotonohaMacLauncher-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) $(KOTONOHA_MODULE_HEADER_ROOTS) $(KOTONOHA_GAME_HEADER_ROOTS) \
    "$(KOTONOHA_ROOT)/launcher/include" \
    "$(KOTONOHA_ROOT)/launcher/core" \
    "$(KOTONOHA_ROOT)/launcher/app" \
    "$(KOTONOHA_ROOT)/lib/include" \
    "$(KOTONOHA_PYTHON_MACOS_SLICE)/Versions/3.15/include/python3.15" \
    "$(KOTONOHA_PYTHON_MACOS_SLICE)/Headers"

// The project compiles and links the real game implementations in-process.
// Individual main.cpp entrypoints are excluded from this single application.
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) \
    KOTONOHA_LAUNCH_AMAGAMI=1 KOTONOHA_LAUNCH_ZERO=1 \
    KOTONOHA_LAUNCH_SNOW=1 KOTONOHA_LAUNCH_SUMMER=1 \
    KOTONOHA_LAUNCH_DDLC=1 KOTONOHA_LAUNCH_KATAWA=1 \
    KOTONOHA_LAUNCH_MEO=1 KOTONOHA_LAUNCH_SCHOOL_DAYS=1 \
    KOTONOHA_LAUNCH_REALLIVE=1 KOTONOHA_LAUNCH_KIRIKIRI=1 \
    KOTONOHA_LAUNCH_LUCA_SYSTEM=1 KOTONOHA_LAUNCH_PMAIL=1 \
    KOTONOHA_LAUNCH_N2SYSTEM=1 KOTONOHA_LAUNCH_PONSCRIPTER=1 \
    KOTONOHA_LAUNCH_ARTEMIS=1 \
    KOTONOHA_MAC_NATIVE_LAUNCHER=1
