<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/school_days_app_name"
        android:textColor="@android:color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/school_days_port"
        android:textColor="#B0B0B0"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/data_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:background="#1E1E1E"
        android:padding="16dp"
        android:text="@string/data_missing"
        android:textColor="#E0E0E0"
        android:textSize="14sp" />

    <Button
        android:id="@+id/import_data"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/import_data" />

    <Button
        android:id="@+id/play_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:enabled="false"
        android:text="@string/play_game" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Android 11+ usa armazenamento com escopo. Os GPKs são importados pelo seletor oficial do Android e ficam na área privada externa do aplicativo; não é necessário acessar Android/data ou Android/obb manualmente."
        android:textColor="#909090"
        android:textSize="12sp" />
</LinearLayout>
